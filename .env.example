# Copy to .env and fill in. docker-compose reads this file automatically.
#   cp .env.example .env

# ---------------------------------------------------------------- required
# Generate with:  openssl rand -base64 48
# If this changes, every existing session is invalidated.
SECRET_KEY=

# ---------------------------------------------------------------- database
POSTGRES_USER=neuroguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=neuroguard

# Local development without Docker falls back to SQLite when unset.
# DATABASE_URL=postgresql+psycopg://neuroguard:change-me@localhost:5432/neuroguard

# ---------------------------------------------------------------- app
ENVIRONMENT=production
DEBUG=false
PORT=8000

# Comma separated. Only needed when the frontend is served from a different
# origin than the API; the Docker image serves both from one origin, so the
# default is sufficient there.
CORS_ORIGINS=http://localhost:8000

# ---------------------------------------------------------------- cookies
# MUST be true in any deployment served over HTTPS, otherwise the browser will
# send the auth cookie over plaintext.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.your-domain.com

# ---------------------------------------------------------------- models
# tiny.en   ~75MB,  lowest memory, noticeably worse transcription
# base.en   ~140MB, the default and a reasonable compromise
# small.en  ~460MB, better accuracy, needs ~2GB RAM
WHISPER_MODEL=base.en

# ------------------------------------------------------- password reset
# Where emailed reset links point. Must be the frontend origin, not the API.
FRONTEND_BASE_URL=http://localhost:5173
RESET_TOKEN_MINUTES=30
# SMTP is optional. Leave SMTP_HOST empty and the reset link is written to the
# application log instead of being emailed — which is what makes the flow
# testable offline and in a demo. Set these for real delivery.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=NeuroGuard <no-reply@example.com>

# ------------------------------------------- DementiaBank (training only)
# TalkBank account with approved DementiaBank access. Needed ONLY to download
# the Pitt corpus for training (python ml/download_pitt.py); the running app
# never uses these. The data is under the TalkBank data-use agreement: do not
# commit it, redistribute it, or copy it into a container image.
# Request access at https://talkbank.org/dementia/access/
TALKBANK_EMAIL=
TALKBANK_PASSWORD=
